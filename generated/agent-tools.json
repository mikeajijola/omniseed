{
  "source": {
    "repository": "omniform",
    "path": "contracts/core.operations.json",
    "catalogVersion": "0.1.0"
  },
  "tools": [
    {
      "name": "get_capability",
      "description": "Get the calculated state, realisations, gaps, and evidence for one capability.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        }
      },
      "outputSchema": {
        "type": [
          "object",
          "null"
        ]
      },
      "metadata": {
        "version": "0.1.0",
        "mutation": false,
        "approval": {
          "mode": "none"
        },
        "risk": "none",
        "permissions": [
          "read_company"
        ]
      }
    },
    {
      "name": "generate_plan",
      "description": "Generate a proposed organisational change plan without authorizing execution.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "definition": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "id",
          "status",
          "changes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "changes": {
            "type": "array"
          }
        }
      },
      "metadata": {
        "version": "0.1.0",
        "mutation": false,
        "approval": {
          "mode": "none"
        },
        "risk": "low",
        "permissions": [
          "plan_company"
        ]
      }
    },
    {
      "name": "apply_plan",
      "description": "Apply explicitly approved changes from the current plan through governed runtime and provider handlers.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "planId",
          "approvedChangeIds",
          "authorization"
        ],
        "properties": {
          "planId": {
            "type": "string"
          },
          "approvedChangeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authorization": {
            "type": "object",
            "required": [
              "actorId",
              "permissions"
            ],
            "properties": {
              "actorId": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "state",
          "results",
          "summary"
        ],
        "properties": {
          "state": {
            "type": "object"
          },
          "results": {
            "type": "array"
          },
          "summary": {
            "type": "object"
          }
        }
      },
      "metadata": {
        "version": "0.1.0",
        "mutation": true,
        "approval": {
          "mode": "required"
        },
        "risk": "high",
        "permissions": [
          "apply_plan"
        ]
      }
    }
  ]
}
